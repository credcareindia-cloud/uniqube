{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.uniqube3d.co/api/:path*"
    },
    {
      "source": "/qr/:path*",
      "destination": "https://api.uniqube3d.co/qr/:path*"
    },
    {
      "source": "/((?!api/|qr/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
