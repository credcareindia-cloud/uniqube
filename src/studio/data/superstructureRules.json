  "rules": {
    "drawing_set": {
      "classify_sheets": [
        "floor_plan",
        "roof_plan",
        "section",
        "elevation"
      ],
      "typical_plans": "Read the level range from the plan title (e.g. 'Typical floor plan, 1st to 4th') and apply the plan to every level in the range.",
      "missing_level": "F-LEVEL-MISSING; no quantities for that level.",
      "conflict": "F-LEVEL-CONFLICT.",
      "roof_plan_required_for": "pitched roofs (F-ROOF-PLAN).",
      "continuity": "Vertical continuity checks run on levels as repeated."
    },
    "wall_height": {
      "formula": "H_i = FFH_i - D_above;  FFH_i = level[i+1] - level[i]",
      "D_above": {
        "truss": "P.floor_zone_deduction_truss_mm",
        "flat_roof_truss": "P.floor_zone_deduction_truss_mm",
        "1200S350": "P.floor_zone_deduction_1200S350_mm",
        "1400S350": "P.floor_zone_deduction_1400S350_mm",
        "pitched_roof": "no deduction; H = eaves_level - FFL_i"
      },
      "build_up": "P.floor_buildup_mm (0)",
      "flags": [
        "F-HEIGHT-CONFLICT",
        "F-HEIGHT-RANGE",
        "F-HEIGHT-LOCAL"
      ],
      "fallback": "No sections or elevations: ask the user for floor-to-floor heights; never assume."
    },
    "walls": {
      "run": "Continuous straight wall end to end or corner to corner; T and X junctions do not split the through wall.",
      "n_p": "ceil(L_run / P.panel_max_length_mm)",
      "L_p": "L_run / n_p   (equal split)",
      "studs_regular": "n_p * (ceil(L_p / s) + 1)",
      "studs_jamb": "openings * 2 * P.jamb_studs_per_side",
      "studs_junction": "n_L * P.junction_studs.L + n_T * P.junction_studs.T + n_X * P.junction_studs.X",
      "junction_attribution": "Count each junction once: T and X on the through wall, L on either run.",
      "stud_length": "H for every stud (regular, jamb, junction)",
      "tracks": "2 * L_run, stud section",
      "nogging_rows": "floor((H - 1) / P.nogging_spacing_mm)",
      "nogging": "nogging_rows * L_run, stud section",
      "tiers": "If H > P.panel_max_height_mm: extra_track = 2 * L_run * (ceil(H / P.panel_max_height_mm) - 1)",
      "weight_kg": "((studs_regular + studs_jamb + studs_junction) * H + 2 * L_run + nogging_rows * L_run + extra_track) / 1000 * kg_per_m(section)",
      "section": "Level row LB or NLB section; tracks and nogging use the stud section (CNC tooling).",
      "openings": "No deduction. Detected from door swings, window symbols and wall gaps. Width >= P.hrs_opening_limit_mm adds an HRS header suggestion.",
      "flags": [
        "F-OPENING-PANEL",
        "F-WALL-GEOMETRY"
      ]
    },
    "floor_trusses": {
      "geometry": "Depth P.truss_depth_mm, Pratt, panels P.truss_panel_mm, weak axis; vertical P.truss_vertical_mm, diagonal P.truss_diagonal_mm.",
      "positions": "Set out at s from a common grid line so trusses align across zones.",
      "line": "At each position, join the spans crossed in the same framing direction into one truss line.",
      "cut_rule": "Walk the line; extend the current piece over the next span while piece + next_span < P.truss_piece_max_length_mm; otherwise cut at that bearing wall.",
      "panels": "p = sum(ceil(span_i / P.truss_panel_mm))  (panels per span, so a vertical sits on every support)",
      "members_mm": {
        "chords": "2 * L_piece",
        "verticals": "(p + 1) * P.truss_vertical_mm",
        "diagonals": "p * P.truss_diagonal_mm",
        "reinforcing": "2 * L_piece if level.reinforcing_studs else 0"
      },
      "blocking_trusses": "Same section and configuration; one along each piece end, two at a cut, one along each intermediate support. Lines over P.truss_piece_max_length_mm split into equal pieces. Reinforcing follows the level toggle.",
      "weight_kg": "total_length_mm / 1000 * kg_per_m(level.framing_section)"
    },
    "c_joists": {
      "span": "Single span per zone; W = zone width perpendicular to span, L_j = span.",
      "joists": "N = ceil(W / s) + 1; length N * L_j",
      "blocking_rows": "r = ceil(L_j / P.joist_blocking_spacing_mm) - 1",
      "blocking": "r * (N - 1) * s, joist section",
      "rim_beams": "2 * W per zone, joist section; P.joist_rims_at_shared_wall at a shared bearing wall",
