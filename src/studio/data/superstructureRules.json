        "sheeting_on_purlins": "Purlins and roof plane bracing apply."
      },
      "pitched_inputs": "Outline, ridge, hip and valley lines (roof plan); pitch from labels (15 deg, 1:4, 3:12) or sections; eaves overhang O; verge overhang G; heel hh = P.heel_height_min_mm.",
      "PR1_decomposition": "Split into gable, hip end, valley and mono-pitch areas; trusses span perpendicular to the ridge; spans over P.max_span_mm get the support check; pieces < P.truss_piece_max_length_mm.",
      "PR2_common_truss": {
        "count": "ceil(ridge_length / s) + 1",
        "dual_pitch": {
          "bottom_chord": "Lt",
          "top_chord": "2 * (Lt/2 + O) / cos(theta)",
          "verticals": "At x = 0, 600, ... < Lt/2 on each half plus the apex: v(x) = hh + x * tan(theta) - 2 * P.s162_flange_mm",
          "diagonals": "One per panel: sqrt(panel_width^2 + v_outer^2), v_outer = shorter vertical of the panel (Pratt, sloping down toward mid-span)"
        },
        "mono_pitch": {
          "bottom_chord": "Lt",
          "top_chord": "(Lt + O_low + O_high) / cos(theta)",
          "verticals": "v(x) from hh to hh + Lt * tan(theta)"
        }
      },
      "PR3_eaves": "Overhang included in the top chord; fascia member (truss section) along eaves with O > 0; O > P.max_eaves_overhang_mm: F-OVERHANG.",
      "PR4_gable_verge": {
        "end_truss": "Common truss (already counted)",
        "rake_length": "(Lt/2 + O) / cos(theta)",
        "outriggers": "ceil(rake_length / s) + 1 per rake, each G * (1 + P.verge_backspan_ratio)",
        "verge_member": "rake_length per rake",
        "flag": "G > P.max_verge_overhang_mm: F-OVERHANG"
      },
